{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "AppDbContext": "Server=(localdb)\\mssqllocaldb;Database=CommitDb;Trusted_Connection=true;"
  },

  "Jwt": {
    "Issuer": "Commit.Api",
    "Audience": "Commit.Api"
  },

  "PlanLimits": {
    "Free": {
      "MaxActiveChallengesJoined": 4,
      "MaxActiveChallengesCreated": 3,
      "MaxParticipantsPerChallenge": 5,
      "AllowOpenEnded": false
    },
    "Plus": {
      "MaxActiveChallengesJoined": null,
      "MaxActiveChallengesCreated": null,
      "MaxParticipantsPerChallenge": 200,
      "AllowOpenEnded": true
    }
  }
}
